PUBLIC_SITE_URL=https://kara.example
ORIGIN=https://kara.example
PUBLIC_APP_STORE_URL=https://apps.apple.com/app/kara/id000000000
PUBLIC_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=app.kara
PUBLIC_SUPPORT_EMAIL=support@kara.example
PUBLIC_LEGAL_NAME=Kara
GOLD_API_KEY=replace-with-your-gold-api-key
REDIS_URL=redis://redis:6379
APP_ATTEST_TEAM_ID=LBPZB5S37F
APP_ATTEST_BUNDLE_ID=com.karaprivate.KARA
APP_ATTEST_ENVIRONMENT=development
APP_ATTEST_RATE_LIMIT_HMAC_SECRET=replace-with-output-of-openssl-rand-base64-32
# APP_ATTEST_RATE_LIMIT_REDIS_PREFIX=kara:app-attest:ip-rate-limit
ASSET_EXTRACTION_ENABLED=false
OPENAI_API_KEY=replace-with-a-restricted-project-key
ASSET_EXTRACTION_HMAC_SECRET=replace-with-output-of-openssl-rand-base64-32
# Optional namespace when staging and production share one Redis instance.
# ASSET_EXTRACTION_REDIS_PREFIX=kara:asset-extraction

# SvelteKit adapter-node / trusted Dokploy proxy settings. The proxy must
# overwrite X-Forwarded-For and have exactly the configured number of hops.
BODY_SIZE_LIMIT=11534336
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1

# Optional for forks; defaults to the public KARA repository.
# METALS_DATA_MANIFEST_URL=https://raw.githubusercontent.com/Sudo-Rahman/KARA/main/website/data/v1/manifest.json
